# Local Python environments and generated Python files
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test and tooling output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/

# Local configuration and editor files
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.log

# Local project data and media assets
/projects/*
!/projects/.gitkeep
/assets/music/*
!/assets/music/.gitkeep
!/assets/music/library.json
!/assets/music/README.md
/assets/sfx/*
!/assets/sfx/.gitkeep
!/assets/sfx/README.md
!/assets/sfx/library.json
!/assets/sfx/library.example.json
!/assets/sfx/audio/
/assets/sfx/audio/*
!/assets/sfx/audio/.gitkeep

# Generated previews and exports
/previews/
/exports/
/tmp/
